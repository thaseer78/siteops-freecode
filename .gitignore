data/
data/**/*.db
data/**/*.db-shm
data/**/*.db-wal
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
.siteops/
keys.json
admin-credentials.txt

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

