# SiteOps — environment template
# Copy to `.env` and fill in only what you need. Nothing here is required to boot;
# missing integrations degrade honestly (see docs/SETUP.md).
# Never commit `.env` or real credentials.

# --- Runtime ---
NODE_ENV=development
PORT=3000
API_PORT=8787
# SERVE_WEB=1            # serve the built SPA from the API (production)

# --- Auth / sessions ---
# Random 32-byte secret. If unset, one is generated once into data/keys.json.
SESSION_SECRET=replace-with-a-long-random-string
# First-boot operator account. If unset, a random password is written to
# data/admin-credentials.txt (delete that file after changing the password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Links ---
# Base URL used in emailed verification/reset links. Falls back to the request host.
APP_URL=http://localhost:3000

# --- Integrations (all optional) ---
# Google PageSpeed Insights: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# Resend email: https://resend.com/api-keys
RESEND_API_KEY=
MAIL_FROM="SiteOps <reports@example.com>"

# Expo push notifications
EXPO_ACCESS_TOKEN=

# --- Local data ---
# Directory for the SQLite DB, keys and admin credentials. Gitignored.
DATA_DIR=data

# --- QA scripts (optional overrides) ---
API_BASE=http://127.0.0.1:8787
WEB_BASE=http://127.0.0.1:3000
