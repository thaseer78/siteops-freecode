# SiteOps — environment template
#
# Copy this file to `.env` and fill in only what you need. Nothing here is
# required to boot: every integration degrades honestly when a value is missing
# (audits report the provider's real error, emails are recorded as
# `not_configured`, push is skipped). Never commit the real `.env`.

# ── Core ────────────────────────────────────────────────────────────────────
# Port for the API process (Vite proxies /api to it). Default 8787.
API_PORT=8787
# Where the SQLite database and keys live. Default ./data
# DATA_DIR=./data
# Public base URL used in emailed links. Falls back to the request host.
# APP_URL=https://your-domain.example
# Secret for session cookies. Leave blank to auto-generate into data/keys.json.
# SESSION_SECRET=
# Set to 1 to let the API serve the built web app from dist/.
# SERVE_WEB=0

# ── First-run operator account ──────────────────────────────────────────────
ADMIN_EMAIL=you@example.com
ADMIN_NAME=SiteOps Admin
ADMIN_PASSWORD=change-me-before-first-run

# ── Google PageSpeed Insights (audit scores) ───────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials with the
# "PageSpeed Insights API" enabled. Keyless mode works with a small shared
# quota; set a key for reliable audits.
PAGESPEED_API_KEY=
# Alias read by some scripts; PAGESPEED_API_KEY takes precedence.
GOOGLE_PAGESPEED_API_KEY=

# ── Resend (transactional email) ───────────────────────────────────────────
# https://resend.com — verify a sending domain, then create a key.
RESEND_API_KEY=
RESEND_FROM_EMAIL="SiteOps <reports@your-domain.example>"
# Older alias still read by the mailer.
MAIL_FROM=

# ── Expo push notifications (mobile) ───────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Supabase (production Postgres / auth path) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
