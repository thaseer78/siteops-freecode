# SiteOps — environment template
#
# Copy this file to `.env` and fill in only what you need. Nothing here is
# required to boot: every integration degrades honestly when a value is missing
# (audits report the provider's real error, emails are recorded as
# `not_configured`, push is skipped). See docs/SETUP.md.
#
# NEVER commit `.env` or any real key, password or database credential.
# Every value below is a placeholder.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Vite dev server port
PORT=3000
# API process port (Vite proxies /api to it)
API_PORT=8787
# Set to 1 to serve the built SPA from the API in production.
# SERVE_WEB=1

# ── Auth / sessions ────────────────────────────────────────────────────────
# Random 32-byte secret. If unset, one is generated once into data/keys.json.
SESSION_SECRET=replace-with-a-long-random-string
# First-boot operator account. If unset, a random password is written to
# data/admin-credentials.txt (delete that file after changing the password).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=SiteOps Admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Links ──────────────────────────────────────────────────────────────────
# Base URL used in emailed verification/reset links. Falls back to the request host.
APP_URL=http://localhost:3000

# ── Local data ─────────────────────────────────────────────────────────────
# Directory for the SQLite DB, keys and admin credentials. Gitignored.
DATA_DIR=data

# ── Integrations (all optional) ────────────────────────────────────────────
# Google PageSpeed Insights: https://console.cloud.google.com/apis/credentials
# Keyless mode works with a small shared quota; set a key for reliable audits.
PAGESPEED_API_KEY=
# Alias read by some scripts; PAGESPEED_API_KEY takes precedence.
GOOGLE_PAGESPEED_API_KEY=

# Resend email: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="SiteOps <reports@example.com>"
# Older alias still read by the mailer.
MAIL_FROM="SiteOps <reports@example.com>"

# Expo push notifications
EXPO_ACCESS_TOKEN=

# ── Supabase (production Postgres / auth path) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── QA scripts (optional overrides) ────────────────────────────────────────
API_BASE=http://127.0.0.1:8787
API_URL=http://127.0.0.1:8787
WEB_BASE=http://127.0.0.1:3000
# Path to a Chromium binary if it is not on the default Playwright path.
# CHROME_PATH=/path/to/chrome
